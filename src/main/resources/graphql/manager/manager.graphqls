type Manager {
  id: ID!
  name: String
  email: String
  avatar: String
  createdAt: LocalDateTime
  managedProperties: [Property]
  managedPropertiesCount: Int
}

extend type Query {
  getManager(id: ID!): Manager
  getAuthenticatedManager: Manager
  getManagedProperties(page: Int = 0, size: Int = 10): PropertyPage
}

extend type Mutation {
  respondToApplication(input: RespondToApplicationDto): Application
}
